<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Transfer" Id="{80f70b09-74c0-4147-96f3-c563c02f3aad}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Transfer
VAR
	INIT				: BOOL := TRUE;
	Definition			: ST_DefinitionATS;
	Status	 			: ST_StatusATS;
	                    
	SystemConfigured 	: BOOL := FALSE;
	
	GenCB				: FB_EmaxBreakerBase;
	LineCB				: FB_EmaxBreakerBase;
	MCM_Line			: FB_MCM_V_Mx_ModbusRTU;
	MCM_Gen				: FB_MCM_V_Mx_ModbusRTU;	
	
	GenStartCommand		AT%Q*	: BOOL; 
            
	TransferTimer   		: TON;    
	RetransferTimer 		: TON;
	BreakerFaultTimer 		: TON;
	VoltageUnstableTimer 	: TON;
	
	TransitionTimer 		: TON;
	CoolDownTimer 			: TON;
	HMICoolDownTime			: STRING;
	LineLossConfirmTimer    : TON;
	
	SystemVoltage		: E_Voltages := E_Voltages._600V; 
	SystemFrequency		: E_Frequencies := E_Frequencies._60Hz;
	VoltageTolerance	: REAL	:= 5;
	FrequencyTolerance	: REAL  := 1;
	PhaseTolerange		: REAL 	:= 10;
	
	HMI_GenStartDelay		: INT	:= 5;
	HMI_ReturnToLineDelay	: INT	:= 5;
	HMI_GenCoolDownDelay	: INT	:= 5;
	HMI_VoltageStabilityDelay	: INT := 10;
	
	ATSMode				: E_Modes := E_Modes.Manual;
	ATSModeString		: STRING := TO_STRING(E_Modes.Manual);
	
	HMI_NonAutoToGen	: BOOL:= FALSE;
	HMI_NonAutoToLine	: BOOL:= FALSE;
	
	Error				: ST_Error;
	ResetErrors			: BOOL := FALSE;
	
	ATSMessage			: STRING:='';
	
	FaultAutoRecoveryTimer  : TON;
	StateValidationTimer    : TON;
	
	LastATSMode     		: E_Modes := E_Modes.Manual;
	GenCoolDownActive 		: BOOL;	
END_VAR

VAR PERSISTENT
	TransferState		: E_TransferState := E_TransferState.STARTUP_CHECK;
	Config				: ST_ConfigATS;
	HMIPassword			: STRING:='2544'; //ALIG
	HardFaultLatch		: BOOL;
    ModeChanged     	: BOOL;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[M_LineCB();
M_GenCB();
M_MCM_Voltmeter();

ATSModeString := TO_STRING(ATSMode);

Config.GenStartDelay     := TO_TIME(HMI_GenStartDelay * 1000);
Config.ReturnToLineDelay := TO_TIME(HMI_ReturnToLineDelay * 1000);
Config.GenCoolDownDelay  := TO_TIME(HMI_GenCoolDownDelay * 60000);
MCM_Gen.P_Config.StableTime  	:= TO_TIME(HMI_VoltageStabilityDelay*1000);
MCM_Line.P_Config.StableTime  	:= TO_TIME(HMI_VoltageStabilityDelay*1000);

// Always evaluate CB positions regardless of mode
Status.BothClosed := LineCB.P_Status.CB_Closed.P_Status.P_Value
                     AND GenCB.P_Status.CB_Closed.P_Status.P_Value;
Status.BothOpened := LineCB.P_Status.CB_Opened.P_Status.P_Value
                     AND GenCB.P_Status.CB_Opened.P_Status.P_Value;

// Detect mode change
ModeChanged := ATSMode <> LastATSMode;

IF ModeChanged THEN
     ADSLOGSTR(
        ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG,
        'ATS | Mode changed to %s',
        TO_STRING(ATSMode)
    );

    IF ATSMode = E_Modes.Automatic THEN
        // Re-entering auto — reconcile physical state fresh
        TransferState             := E_TransferState.STARTUP_CHECK;
        FaultAutoRecoveryTimer.IN := FALSE;
        StateValidationTimer.IN   := FALSE;
    ELSE
        // Leaving auto — safe the outputs
        THIS^.GenStartCommand := FALSE;
    END_IF

    LastATSMode := ATSMode;
END_IF

CASE ATSMode OF
    E_Modes.Automatic:
        M_AutoStateMachine();

    E_Modes.NonAutomatic:
        IF HMI_NonAutoToGen THEN
            M_TransferToGen();
        ELSIF HMI_NonAutoToLine THEN
            M_TransferToLine();
        END_IF

    E_Modes.Manual:
		IF INIT THEN
			IF LineCB.P_Status.CB_Closed.P_Status.P_Value THEN
				LineCB.M_Open();
			END_IF
			IF GenCB.P_Status.CB_Closed.P_Status.P_Value THEN
				GenCB.M_Open();
			END_IF
		END_IF
        // DO NOTHING - BREAKERS TO BE OPERATED MANUALLY

END_CASE

IF ATSMode <> E_Modes.NonAutomatic THEN
    HMI_NonAutoToGen  := FALSE;
    HMI_NonAutoToLine := FALSE;
END_IF

IF ResetErrors THEN
    M_ResetErrors();
END_IF

INIT := FALSE;]]></ST>
    </Implementation>
    <Folder Name="Devices" Id="{0f8978a1-dd06-4f57-828d-45828f0df427}" />
    <Method Name="M_AutoStateMachine" Id="{7309beaf-6981-4895-822f-b929ea1bb9d2}">
      <Declaration><![CDATA[METHOD PRIVATE M_AutoStateMachine

]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.BothClosed := LineCB.P_Status.CB_Closed.P_Status.P_Value 
                     AND GenCB.P_Status.CB_Closed.P_Status.P_Value;
Status.BothOpened := LineCB.P_Status.CB_Opened.P_Status.P_Value 
                     AND GenCB.P_Status.CB_Opened.P_Status.P_Value;

IF Status.BothClosed THEN
    GenCB.M_Open();
    LineCB.M_Open();
END_IF

Status.TransferFault := Status.BothClosed
                        OR GenCB.P_Status.Error.Error
                        OR LineCB.P_Status.Error.Error;

IF Status.TransferFault AND TransferState <> E_TransferState.STARTUP_CHECK THEN
    TransferState := E_TransferState.FAULT;
END_IF

CASE TransferState OF

    E_TransferState.STARTUP_CHECK:
        LineLossConfirmTimer.IN := FALSE;
        TransitionTimer.IN      := FALSE;
        RetransferTimer.IN      := FALSE;
        CoolDownTimer.IN        := FALSE;
        BreakerFaultTimer.IN    := FALSE;
        VoltageUnstableTimer.IN := FALSE;

		IF NOT SystemConfigured THEN
			ATSMessage := 'Please Configure System Voltage and Frequency to Continue';
			RETURN;
		END_IF
        IF Status.BothOpened AND MCM_Line.P_DataOut.VoltageStabilized THEN
            LineCB.M_Close();
            TransferState := E_TransferState.CLOSING_LINE_CB;
		ELSIF Status.BothOpened AND MCM_Gen.P_DataOut.VoltageStabilized THEN
            TransferState := E_TransferState.CLOSING_GEN_CB;
        ELSIF LineCB.P_Status.CB_Closed.P_Status.P_Value 
              AND MCM_Line.P_DataOut.VoltageStabilized THEN
            GenCoolDownActive := FALSE;
            TransferState     := E_TransferState.LINE_NORMAL;

        ELSIF LineCB.P_Status.CB_Closed.P_Status.P_Value 
              AND NOT MCM_Line.P_DataOut.VoltageStabilized THEN
            TransferState := E_TransferState.LINE_LOSS_PENDING;

        ELSIF GenCB.P_Status.CB_Closed.P_Status.P_Value 
              AND MCM_Gen.P_DataOut.VoltageStabilized THEN
            THIS^.GenStartCommand := TRUE;
            TransferState         := E_TransferState.ON_GENERATOR;

        ELSIF GenCB.P_Status.CB_Closed.P_Status.P_Value 
              AND NOT MCM_Gen.P_DataOut.VoltageStabilized THEN
            GenCB.M_Open();
            THIS^.GenStartCommand := FALSE;
            GenCoolDownActive     := FALSE;
            TransferState         := E_TransferState.OPENING_GEN_CB;

        ELSIF Status.BothOpened 
              AND NOT MCM_Line.P_DataOut.VoltageStabilized 
              AND NOT MCM_Gen.P_DataOut.VoltageStabilized THEN
            TransferState := E_TransferState.GEN_START_DELAY;

        ELSIF Status.TransferFault THEN
            TransferState := E_TransferState.FAULT;
        END_IF

    E_TransferState.LINE_NORMAL:
        LineLossConfirmTimer.PT := Config.LineLossConfirmDelay;
        LineLossConfirmTimer.IN := NOT MCM_Line.P_DataOut.VoltageStabilized;

        CoolDownTimer.IN := GenCoolDownActive;

        IF CoolDownTimer.Q THEN
            THIS^.GenStartCommand := FALSE;
            GenCoolDownActive     := FALSE;
            CoolDownTimer.IN      := FALSE;
        END_IF

        IF LineLossConfirmTimer.Q THEN
            LineLossConfirmTimer.IN := FALSE;
            GenCoolDownActive       := FALSE;
            CoolDownTimer.IN        := FALSE;
            TransferState           := E_TransferState.LINE_LOST;
        END_IF

    E_TransferState.LINE_LOSS_PENDING:
        LineLossConfirmTimer.PT := Config.LineLossConfirmDelay;
        LineLossConfirmTimer.IN := TRUE;

        IF MCM_Line.P_DataOut.VoltageStabilized THEN
            LineLossConfirmTimer.IN := FALSE;
            TransferState           := E_TransferState.LINE_NORMAL;

        ELSIF LineLossConfirmTimer.Q THEN
            LineLossConfirmTimer.IN := FALSE;
            GenCoolDownActive       := FALSE;
            CoolDownTimer.IN        := FALSE;
            TransferState           := E_TransferState.LINE_LOST;
        END_IF

    E_TransferState.LINE_LOST:
        THIS^.GenStartCommand := FALSE;
        TransferState         := E_TransferState.OPENING_LINE_CB;

    E_TransferState.OPENING_LINE_CB:
        LineCB.M_Open();

        BreakerFaultTimer.PT := Config.FaultTimeOut;
        BreakerFaultTimer.IN := NOT LineCB.P_Status.CB_Opened.P_Status.P_Value;

        IF MCM_Line.P_DataOut.VoltageStabilized AND Config.AutoReturnToLine THEN
            BreakerFaultTimer.IN := FALSE;
            TransferState        := E_TransferState.CLOSING_LINE_CB;

        ELSIF LineCB.P_Status.CB_Opened.P_Status.P_Value THEN
            BreakerFaultTimer.IN := FALSE;
            TransferState        := E_TransferState.GEN_START_DELAY;

        ELSIF BreakerFaultTimer.Q THEN
            BreakerFaultTimer.IN := FALSE;
            TransferState        := E_TransferState.FAULT;
        END_IF

    E_TransferState.GEN_START_DELAY:
        TransitionTimer.PT := Config.GenStartDelay;
        TransitionTimer.IN := TRUE;

        IF MCM_Line.P_DataOut.VoltageStabilized AND Config.AutoReturnToLine THEN
            TransitionTimer.IN := FALSE;
            TransferState      := E_TransferState.CLOSING_LINE_CB;

        ELSIF TransitionTimer.Q THEN
            TransitionTimer.IN := FALSE;
            TransferState      := E_TransferState.GEN_START;
        END_IF

    E_TransferState.GEN_START:
        THIS^.GenStartCommand := TRUE;

        VoltageUnstableTimer.PT := Config.GenFaultTimeOut;
        VoltageUnstableTimer.IN := NOT MCM_Gen.P_DataOut.VoltageStabilized;

        IF MCM_Line.P_DataOut.VoltageStabilized AND Config.AutoReturnToLine THEN
            VoltageUnstableTimer.IN := FALSE;
            TransferState           := E_TransferState.LINE_RESTORED;

        ELSIF MCM_Gen.P_DataOut.VoltageStabilized THEN
            VoltageUnstableTimer.IN := FALSE;
            TransferState           := E_TransferState.CLOSING_GEN_CB;

        ELSIF VoltageUnstableTimer.Q THEN
            VoltageUnstableTimer.IN := FALSE;
            THIS^.GenStartCommand   := FALSE;
            TransferState           := E_TransferState.FAULT;
        END_IF

    E_TransferState.CLOSING_GEN_CB:
        IF LineCB.P_Status.CB_Opened.P_Status.P_Value THEN
            GenCB.M_Close();
        END_IF

        BreakerFaultTimer.PT := Config.FaultTimeOut;
        BreakerFaultTimer.IN := NOT GenCB.P_Status.CB_Closed.P_Status.P_Value;

        IF GenCB.P_Status.CB_Closed.P_Status.P_Value THEN
            BreakerFaultTimer.IN := FALSE;
            TransferState        := E_TransferState.ON_GENERATOR;

        ELSIF BreakerFaultTimer.Q THEN
            BreakerFaultTimer.IN := FALSE;
            TransferState        := E_TransferState.FAULT;
        END_IF

    E_TransferState.ON_GENERATOR:
        RetransferTimer.PT := Config.ReturnToLineDelay;

        IF MCM_Line.P_DataOut.VoltageStabilized AND Config.AutoReturnToLine THEN
            RetransferTimer.IN := TRUE;
        ELSE
            RetransferTimer.IN := FALSE;
        END_IF

        IF RetransferTimer.Q THEN
            RetransferTimer.IN := FALSE;
            TransferState      := E_TransferState.OPENING_GEN_CB;
        END_IF

    E_TransferState.LINE_RESTORED:
        IF Config.AutoReturnToLine THEN
            GenCoolDownActive := TRUE;
            TransferState     := E_TransferState.CLOSING_LINE_CB;
        ELSE
            TransferState := E_TransferState.CLOSING_GEN_CB;
        END_IF

    E_TransferState.OPENING_GEN_CB:
        GenCB.M_Open();

        BreakerFaultTimer.PT := Config.FaultTimeOut;
        BreakerFaultTimer.IN := NOT GenCB.P_Status.CB_Opened.P_Status.P_Value;

        IF GenCB.P_Status.CB_Opened.P_Status.P_Value THEN
            BreakerFaultTimer.IN := FALSE;
            TransitionTimer.PT   := Config.ToLineTransitionTime;
            TransitionTimer.IN   := FALSE;
            TransferState        := E_TransferState.RETRANSFER_DELAY;

        ELSIF BreakerFaultTimer.Q THEN
            BreakerFaultTimer.IN := FALSE;
            TransferState        := E_TransferState.FAULT;
        END_IF

    E_TransferState.RETRANSFER_DELAY:
        TransitionTimer.IN := TRUE;

        IF TransitionTimer.Q THEN
            TransitionTimer.IN := FALSE;
            TransferState      := E_TransferState.CLOSING_LINE_CB;
        END_IF

    E_TransferState.CLOSING_LINE_CB:
        IF GenCB.P_Status.CB_Opened.P_Status.P_Value THEN
            LineCB.M_Close();
        END_IF

        BreakerFaultTimer.PT := Config.FaultTimeOut;
        BreakerFaultTimer.IN := NOT LineCB.P_Status.CB_Closed.P_Status.P_Value;

        IF LineCB.P_Status.CB_Closed.P_Status.P_Value THEN
            BreakerFaultTimer.IN := FALSE;
            IF THIS^.GenStartCommand THEN
                GenCoolDownActive := TRUE;
            END_IF
            TransferState := E_TransferState.GEN_COOLDOWN;

        ELSIF BreakerFaultTimer.Q THEN
            BreakerFaultTimer.IN := FALSE;
            TransferState        := E_TransferState.FAULT;
        END_IF

    E_TransferState.GEN_COOLDOWN:
        THIS^.GenStartCommand := TRUE;

        CoolDownTimer.IN := TRUE;

        IF NOT MCM_Line.P_DataOut.VoltageStabilized THEN
            CoolDownTimer.IN  := FALSE;
            GenCoolDownActive := FALSE;
            TransferState     := E_TransferState.LINE_LOSS_PENDING;

        ELSIF CoolDownTimer.Q THEN
            THIS^.GenStartCommand := FALSE;
            GenCoolDownActive     := FALSE;
            CoolDownTimer.IN      := FALSE;
            TransferState         := E_TransferState.LINE_NORMAL;
        END_IF

    E_TransferState.FAULT:
		LineCB.M_Open();
		GenCB.M_Open();
		THIS^.GenStartCommand := FALSE;
		GenCoolDownActive     := FALSE;
	
		TransitionTimer.IN      := FALSE;
		RetransferTimer.IN      := FALSE;
		CoolDownTimer.IN        := FALSE;
		BreakerFaultTimer.IN    := FALSE;
		VoltageUnstableTimer.IN := FALSE;
		LineLossConfirmTimer.IN := FALSE;
	
		IF Status.BothClosed THEN
			HardFaultLatch := TRUE;
		END_IF
	
		FaultAutoRecoveryTimer.PT := Config.FaultAutoRecoveryDelay;
		FaultAutoRecoveryTimer.IN := NOT Status.BothClosed
									 AND NOT GenCB.P_Status.Error.Error
									 AND NOT LineCB.P_Status.Error.Error
									 AND NOT HardFaultLatch;
	
		IF ResetErrors AND NOT Status.BothClosed THEN
			FaultAutoRecoveryTimer.IN := FALSE;
			HardFaultLatch            := FALSE;
			LineCB.M_ResetErrors();
			GenCB.M_ResetErrors();
			ADSLOGSTR(
				ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG,
				'ATS | Fault cleared by operator - returning to STARTUP_CHECK',
				''
			);
			TransferState := E_TransferState.STARTUP_CHECK;
	
		ELSIF FaultAutoRecoveryTimer.Q THEN
			FaultAutoRecoveryTimer.IN := FALSE;
			LineCB.M_ResetErrors();
			GenCB.M_ResetErrors();
			ADSLOGSTR(
				ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG,
				'ATS | Fault auto-recovered after %s - returning to STARTUP_CHECK',
				TO_STRING(Config.FaultAutoRecoveryDelay)
			);
			TransferState := E_TransferState.STARTUP_CHECK;
		END_IF

END_CASE

TransitionTimer();
RetransferTimer();
CoolDownTimer(PT:=Config.GenCoolDownDelay);

HMICoolDownTime := LEFT(
    RIGHT(TO_STRING(CoolDownTimer.PT - CoolDownTimer.ET), 
          LEN(TO_STRING(CoolDownTimer.PT - CoolDownTimer.ET)) - 2),
    FIND(RIGHT(TO_STRING(CoolDownTimer.PT - CoolDownTimer.ET),
               LEN(TO_STRING(CoolDownTimer.PT - CoolDownTimer.ET)) - 2), 's')
);

BreakerFaultTimer();
VoltageUnstableTimer();
LineLossConfirmTimer();
FaultAutoRecoveryTimer();
StateValidationTimer();

M_ValidateState();

M_MessageUpdate();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GenCB" Id="{1b42c6b1-77a5-4799-a20f-060ab13156d7}" FolderPath="Devices\">
      <Declaration><![CDATA[METHOD PRIVATE M_GenCB

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF INIT THEN
	GenCB.P_Definition.Name					:= 'Gen CB';
	GenCB.P_Definition.Description			:= 'Generator Circuit Breaker';
	GenCB.P_Definition.Location				:= 'ATS';
	GenCB.P_Definition.Tag					:= 'CB_GEN';
	GenCB.P_Definition.Rating_V				:= '600 V';
	GenCB.P_Definition.Rating_In			:= '3000 A';
	GenCB.P_Definition.Rating_If			:= '3200 A';
	GenCB.P_Definition.Rating_kA			:= '50 kA';
	
	GenCB.P_Config.Opening_Duration			:= T#1000MS;
	GenCB.P_Config.Closing_Duration			:= T#1000MS;
END_IF

GenCB();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_LineCB" Id="{d32d701a-8eee-4a2f-92c1-00a9f6395687}" FolderPath="Devices\">
      <Declaration><![CDATA[METHOD PRIVATE M_LineCB
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF INIT THEN
	LineCB.P_Definition.Name					:= 'Line CB';
	LineCB.P_Definition.Description				:= 'Line Circuit Breaker';
	LineCB.P_Definition.Location				:= 'ATS';
	LineCB.P_Definition.Tag						:= 'CB_LINE';
	LineCB.P_Definition.Rating_V				:= '600 V';
	LineCB.P_Definition.Rating_In				:= '3000 A';
	LineCB.P_Definition.Rating_If				:= '3200 A';
	LineCB.P_Definition.Rating_kA				:= '50 kA';
	
	LineCB.P_Config.Opening_Duration			:= T#1000MS;
	LineCB.P_Config.Closing_Duration			:= T#1000MS;
END_IF

LineCB();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_MCM_Voltmeter" Id="{1c308eb5-3302-48f4-893e-e4854e19c19f}" FolderPath="Devices\">
      <Declaration><![CDATA[METHOD PRIVATE M_MCM_Voltmeter
VAR_INST
	LastLineDataCount	: UDINT;
	LastGenDataCount	: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF INIT THEN
	MCM_Line.P_Definition.Name			:= 'MCM-V-Mx 1';
	MCM_Line.P_Definition.Description	:= 'Line Side Voltage Meter';
	MCM_Line.P_Definition.Tag			:= 'PT01';
	MCM_Line.P_Config.RetryTime			:= T#1000MS;
	MCM_Line.P_Config.SlaveAddr			:= 1;
	MCM_Line.P_Config.Timeout			:= T#100MS;
	MCM_Line.P_Config.SampleTime		:= T#200MS;
	
	MCM_Gen.P_Definition.Name			:= 'MCM-V-Mx 2';
	MCM_Gen.P_Definition.Description	:= 'Generator Side Voltage Meter';
	MCM_Gen.P_Definition.Tag			:= 'PT02';
	MCM_Gen.P_Config.RetryTime			:= T#1000MS;
	MCM_Gen.P_Config.SlaveAddr			:= 2;
	MCM_Gen.P_Config.Timeout			:= T#100MS;
	MCM_Gen.P_Config.SampleTime			:= T#200MS;
END_IF

MCM_Gen.P_Config.NominalVoltage		:= MCM_Line.P_Config.NominalVoltage		:= TO_INT(SystemVoltage);
MCM_Gen.P_Config.NominalFrequency	:= MCM_Line.P_Config.NominalFrequency	:= TO_INT(SystemFrequency);

MCM_Gen.P_Config.VoltageTolerance	:= MCM_Line.P_Config.VoltageTolerance 	:= VoltageTolerance;
MCM_Gen.P_Config.FrequencyTolerance	:= MCM_Line.P_Config.FrequencyTolerance	:= FrequencyTolerance;
MCM_Gen.P_Config.AngleTolerance		:= MCM_Line.P_Config.AngleTolerance		:= PhaseTolerange;


MCM_Line();
MCM_Gen();

MCM_Line.P_Config.Enable:=TRUE;
MCM_Gen.P_Config.Enable:=TRUE;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_MessageUpdate" Id="{12106db3-e9db-433c-a0a8-8fa10b936fb7}">
      <Declaration><![CDATA[METHOD PRIVATE M_MessageUpdate
VAR_INST
    LastState       : E_TransferState := E_TransferState.STARTUP_CHECK;
    StateChanged    : BOOL;

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[StateChanged := TransferState <> LastState;

CASE TransferState OF

    E_TransferState.STARTUP_CHECK:
        ATSMessage                   := 'ATS Starting - Checking System State';
        Status.InStartupCheck        := TRUE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := FALSE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.LINE_NORMAL:
        ATSMessage                   := 'System On Utility Power';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := LineCB.P_Status.CB_Closed.P_Status.P_Value;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := GenCoolDownActive;
        Status.GeneratorCoolingDown  := GenCoolDownActive;

    E_TransferState.LINE_LOSS_PENDING:
        ATSMessage                   := 'Utility Voltage Unstable - Confirming Loss';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := TRUE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := TRUE;
        Status.GeneratorRunning      := FALSE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.LINE_LOST:
        ATSMessage                   := 'Utility Power Loss Confirmed';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := FALSE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.OPENING_LINE_CB:
        ATSMessage                   := 'Opening Line Breaker';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := FALSE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.GEN_START_DELAY:
        ATSMessage                   := 'Waiting Before Generator Start';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := FALSE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.GEN_START:
        ATSMessage                   := 'Generator Starting - Waiting for Voltage';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := TRUE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.CLOSING_GEN_CB:
        ATSMessage                   := 'Closing Generator Breaker';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := TRUE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.ON_GENERATOR:
        IF Config.AutoReturnToLine THEN
            ATSMessage               := 'On Generator Power - Will Return to Utility When Available';
        ELSE
            ATSMessage               := 'On Generator Power - Manual Return to Utility Required';
        END_IF
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := GenCB.P_Status.CB_Closed.P_Status.P_Value;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := TRUE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.LINE_RESTORED:
        IF Config.AutoReturnToLine THEN
            ATSMessage               := 'Utility Restored - Returning to Utility Power';
        ELSE
            ATSMessage               := 'Utility Restored - Continuing on Generator (Auto Return Disabled)';
        END_IF
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := TRUE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.OPENING_GEN_CB:
        ATSMessage                   := 'Opening Generator Breaker - Retransferring to Utility';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := TRUE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.RETRANSFER_DELAY:
        ATSMessage                   := 'Open Transition Dead Time - Waiting Before Closing Line Breaker';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := TRUE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.CLOSING_LINE_CB:
        ATSMessage                   := 'Closing Line Breaker';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := FALSE;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := TRUE;
        Status.GeneratorCoolingDown  := FALSE;

    E_TransferState.GEN_COOLDOWN:
        ATSMessage                   := 'On Utility Power - Generator Cooling Down';
        Status.InStartupCheck        := FALSE;
        Status.OnLine                := LineCB.P_Status.CB_Closed.P_Status.P_Value;
        Status.OnGenerator           := FALSE;
        Status.LineLossPending       := FALSE;
        Status.GeneratorRunning      := TRUE;
        Status.GeneratorCoolingDown  := TRUE;
	
	E_TransferState.FAULT:
		IF HardFaultLatch THEN
			ATSMessage := 'ATS HARD FAULT - Both Breakers Closed - Operator Reset Required';
		ELSE
			ATSMessage := 'ATS FAULT - Auto Recovery Pending';
		END_IF
		Status.InStartupCheck        := FALSE;
		Status.OnLine                := FALSE;
		Status.OnGenerator           := FALSE;
		Status.LineLossPending       := FALSE;
		Status.GeneratorRunning      := FALSE;
		Status.GeneratorCoolingDown  := FALSE;

END_CASE

IF StateChanged THEN
    CASE TransferState OF
        E_TransferState.FAULT:
            ADSLOGSTR(ADSLOG_MSGTYPE_ERROR OR ADSLOG_MSGTYPE_LOG, 'ATS | %s', ATSMessage);
        E_TransferState.LINE_LOSS_PENDING,
        E_TransferState.LINE_LOST,
        E_TransferState.LINE_RESTORED:
            ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'ATS | %s', ATSMessage);
    ELSE
        ADSLOGSTR(ADSLOG_MSGTYPE_HINT OR ADSLOG_MSGTYPE_LOG, 'ATS | %s', ATSMessage);
    END_CASE

    LastState := TransferState;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ResetErrors" Id="{f4d2a4f3-9b34-41a6-817c-038d452b2c81}">
      <Declaration><![CDATA[METHOD M_ResetErrors
]]></Declaration>
      <Implementation>
        <ST><![CDATA[LineCB.M_ResetErrors();
GenCB.M_ResetErrors();
ATSMessage:='';
ResetErrors:= FALSE;
HMI_NonAutoToGen:= FALSE;
HMI_NonAutoToLine:= FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_TransferToGen" Id="{296e3694-7292-460a-af37-b303b864889e}">
      <Declaration><![CDATA[METHOD M_TransferToGen
VAR_INST
	CB_Delay		: TON;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF 	NOT GenCB.P_Status.Error.Error
	AND NOT LineCB.P_Status.Error.Error 
	AND	NOT GenCB.P_Status.CB_Closed.P_Status.P_Value
THEN
	IF LineCB.P_Status.CB_Closed.P_Status.P_Value THEN
		LineCB.M_Open();
		CB_Delay.IN:=TRUE;
		Status.OnLine:= FALSE;
	END_IF
	IF LineCB.P_Status.CB_Opened.P_Status.P_Value AND NOT LineCB.P_Status.CB_Closed.P_Status.P_Value THEN
		IF NOT GenCB.P_Status.CB_Closing  AND CB_Delay.Q THEN//AND MCM_Gen.P_DataOut.VoltageStabilized THEN //one shot
			GenCB.M_Close();
			CB_Delay.IN:=FALSE;
		END_IF
		Status.OnLine:= FALSE;
		IF GenCB.P_Status.CB_Closed.P_Status.P_Value THEN
			Status.OnGenerator:= TRUE;
			HMI_NonAutoToGen:= FALSE;
		END_IF
	END_IF
ELSE //TODO error handling
	Status.OnGenerator:= TRUE;
	HMI_NonAutoToGen:= FALSE;
END_IF

CB_Delay(PT:=T#1S);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_TransferToLine" Id="{25ba2139-f11f-4b85-a5a3-46eb64cd0748}">
      <Declaration><![CDATA[METHOD M_TransferToLine
VAR_INST
	CB_Delay		: TON;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF 	NOT GenCB.P_Status.Error.Error
	AND NOT LineCB.P_Status.Error.Error 
	AND	NOT LineCB.P_Status.CB_Closed.P_Status.P_Value
THEN
	IF GenCB.P_Status.CB_Closed.P_Status.P_Value THEN
		GenCB.M_Open();
		CB_Delay.IN:=TRUE;
		Status.OnGenerator:= FALSE;
	END_IF
	IF GenCB.P_Status.CB_Opened.P_Status.P_Value AND NOT GenCB.P_Status.CB_Closed.P_Status.P_Value THEN
		IF NOT LineCB.P_Status.CB_Closing AND CB_Delay.Q THEN//AND MCM_Line.P_DataOut.VoltageStabilized THEN //one shot
			LineCB.M_Close();
			CB_Delay.IN:=FALSE;
		END_IF
		Status.OnGenerator:= FALSE;
		IF LineCB.P_Status.CB_Closed.P_Status.P_Value THEN
			Status.OnLine:= TRUE;
			HMI_NonAutoToLine:= FALSE;
		END_IF
	END_IF
ELSE //TODO Error handling
	Status.OnLine		:= TRUE;
	HMI_NonAutoToLine	:= FALSE;

END_IF

CB_Delay(PT:=T#1S);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ValidateState" Id="{0e480f41-c94e-499f-b623-0c3367ac120a}">
      <Declaration><![CDATA[METHOD PRIVATE M_ValidateState
VAR
    PreconditionViolated : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[PreconditionViolated := FALSE;

CASE TransferState OF

    E_TransferState.LINE_NORMAL,
    E_TransferState.LINE_LOSS_PENDING:
        IF NOT LineCB.P_Status.CB_Closed.P_Status.P_Value THEN
            PreconditionViolated := TRUE;
        END_IF

    E_TransferState.ON_GENERATOR:
        IF NOT GenCB.P_Status.CB_Closed.P_Status.P_Value THEN
            PreconditionViolated := TRUE;
        END_IF

    E_TransferState.GEN_COOLDOWN:
        IF NOT LineCB.P_Status.CB_Closed.P_Status.P_Value THEN
            PreconditionViolated := TRUE;
        END_IF

    E_TransferState.GEN_START,
    E_TransferState.GEN_START_DELAY:
        IF NOT LineCB.P_Status.CB_Opened.P_Status.P_Value THEN
            PreconditionViolated := TRUE;
        END_IF

    E_TransferState.RETRANSFER_DELAY:
        IF NOT Status.BothOpened THEN
            PreconditionViolated := TRUE;
        END_IF

END_CASE

IF PreconditionViolated THEN
    ATSMode := E_Modes.Manual;
    ADSLOGSTR(
        ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG,
        'ATS | Manual intervention detected in state %s - switching to Manual mode',
        TO_STRING(TransferState)
    );
END_IF]]></ST>
      </Implementation>
    </Method>
