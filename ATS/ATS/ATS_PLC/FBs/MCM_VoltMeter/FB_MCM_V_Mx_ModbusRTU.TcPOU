<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_MCM_V_Mx_ModbusRTU" Id="{1ca84450-dc7b-43bd-b6b9-283fa8345226}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MCM_V_Mx_ModbusRTU
VAR_INPUT
    Enable         : BOOL;
    SlaveAddr      : BYTE := 1;
    Timeout        : TIME := T#1S;
END_VAR
VAR_OUTPUT
    (* ── Bank A: 16-bit integers ── *)
    DeviceID       : INT;
    VA_16          : REAL;
    VB_16          : REAL;
    VC_16          : REAL;
    VAvg_16        : REAL;
    VAB_16         : REAL;
    VBC_16         : REAL;
    VCA_16         : REAL;
    VLLAvg_16      : REAL;
    AngAB_16       : REAL;
    AngBC_16       : REAL;
    AngAC_16       : REAL;
    Freq_16        : REAL;
    Overflow       : WORD;
 
    (* ── Bank B: 32-bit floats ── *)
    VoltageA       : REAL;
    fVoltageB       : REAL;
    VoltageC       : REAL;
    VoltageAvg     : REAL;
    VoltageAB      : REAL;
    VoltageBC      : REAL;
    VoltageCA      : REAL;
    VoltageLLAvg   : REAL;
    AngleAB        : REAL;
    AngleBC        : REAL;
    AngleAC        : REAL;
    Frequency      : REAL;
 
    (* ── Bank C: config / info ── *)
    PT_Pri_All     : WORD;
    PT_Sec_All     : WORD;
    PT_Pri_A       : WORD;
    PT_Sec_A       : WORD;
    PT_Pri_B       : WORD;
    PT_Sec_B       : WORD;
    PT_Pri_C       : WORD;
    PT_Sec_C       : WORD;
    Debug16        : INT;
    Debug32        : UDINT;
    DebugFloat     : REAL;
    Uptime         : UDINT;
    LittleEndian   : BOOL;
    VoltLEDThr     : INT;
    SerialNum     : UDINT;
    HWVersion      : WORD;
    FWVersion      : WORD;
    BLVersion      : WORD;
    ModelNumber    : WORD;
    InputConfig    : WORD;
    LockState      : WORD;
    AutoFreqCh     : BOOL;
    FreqChannel    : WORD;
 
    (* ── Status ── *)
    Busy           : BOOL;
    Error          : BOOL;
    ErrorId        : MODBUS_ERRORS;
    NewData        : BOOL;
END_VAR
VAR
    (* Link this instance to the EL6022 in the I/O tree *)
    Modbus        : ModbusRtuMasterV2_KL6x22B;
 
    RawA          : ARRAY[0..13] OF WORD;   (* Bank A: 40001-40014, 14 regs *)
    RawB          : ARRAY[0..23] OF WORD;   (* Bank B: 40017-40040, 24 regs *)
    RawC          : ARRAY[0..28] OF WORD;   (* Bank C: 40049-40077, 29 regs *)
 
    State          : E_ReadState := E_ReadState.Idle;
    Execute        : BOOL;
    Retry          : TON;
END_VAR
VAR CONSTANT
    START_A       : UINT := 0;
    COUNT_A       : UINT := 14;
    START_B       : UINT := 16;
    COUNT_B       : UINT := 24;
    START_C       : UINT := 48;
    COUNT_C       : UINT := 29;
    RETRY_TIME    : TIME := T#500MS;
END_VAR
 ]]></Declaration>
    <Implementation>
      <ST><![CDATA[NewData := FALSE;
 
IF NOT Enable THEN
    State   := E_ReadState.Idle;
    Busy    := FALSE;
    Execute := FALSE;
END_IF
 
CASE State OF
 
    E_ReadState.Idle:
        Busy    := FALSE;
        Execute := FALSE;
        IF Enable THEN
            State := E_ReadState.ReadBankA;
        END_IF
 
    (* ══════════════════════════════════════════════════════
       BANK A — FC03, regs 40001-40014
       ══════════════════════════════════════════════════════ *)
    E_ReadState.ReadBankA:
        Busy    := TRUE;
        Error   := FALSE;
        Execute := TRUE;
        Modbus.ReadRegs(
            UnitID      := SlaveAddr,
            Quantity    := COUNT_A,
            MBAddr      := START_A,
            cbLength    := SIZEOF(RawA),
            pMemoryAddr := ADR(RawA),
            Execute     := Execute,
            Timeout     := Timeout
        );
        State := E_ReadState.WaitBankA;
 
    E_ReadState.WaitBankA:
        Modbus.ReadRegs(
            UnitID      := SlaveAddr,
            Quantity    := COUNT_A,
            MBAddr      := START_A,
            cbLength    := SIZEOF(RawA),
            pMemoryAddr := ADR(RawA),
            Execute     := Execute,
            Timeout     := Timeout
        );
        IF NOT Modbus.Busy THEN
            Execute := FALSE;
            IF Modbus.Error THEN
                ErrorId := Modbus.ErrorId;
                Error   := TRUE;
                State   := E_ReadState.ErrorDelay;
            ELSE
                State := E_ReadState.ResetBankB;
            END_IF
        END_IF
	 E_ReadState.ResetBankB:
		Execute := FALSE;
		Modbus.ReadRegs(
			UnitID      := SlaveAddr,
			Quantity    := COUNT_B,
			MBAddr      := START_B,
			cbLength    := SIZEOF(RawB),
			pMemoryAddr := ADR(RawB),
			Execute     := Execute,
			Timeout     := Timeout
		);
		State := E_ReadState.ReadBankB;
    (* ══════════════════════════════════════════════════════
       BANK B — FC03, regs 40017-40040
       ══════════════════════════════════════════════════════ *)
    E_ReadState.ReadBankB:
        Execute := TRUE;
        Modbus.ReadRegs(
            UnitID      := SlaveAddr,
            Quantity    := COUNT_B,
            MBAddr      := START_B,
            cbLength    := SIZEOF(RawB),
            pMemoryAddr := ADR(RawB),
            Execute     := Execute,
            Timeout     := Timeout
        );
        State := E_ReadState.WaitBankB;
 
    E_ReadState.WaitBankB:
        Modbus.ReadRegs(
            UnitID      := SlaveAddr,
            Quantity    := COUNT_B,
            MBAddr      := START_B,
            cbLength    := SIZEOF(RawB),
            pMemoryAddr := ADR(RawB),
            Execute     := Execute,
            Timeout     := Timeout
        );
        IF NOT Modbus.Busy THEN
            Execute := FALSE;
            IF Modbus.Error THEN
                ErrorId := Modbus.ErrorId;
                Error   := TRUE;
                State   := E_ReadState.ErrorDelay;
            ELSE
                State := E_ReadState.ResetBankC;
            END_IF
        END_IF
 	E_ReadState.ResetBankC:
		Execute := FALSE;
		Modbus.ReadRegs(
			UnitID      := SlaveAddr,
			Quantity    := COUNT_C,
			MBAddr      := START_C,
			cbLength    := SIZEOF(RawC),
			pMemoryAddr := ADR(RawC),
			Execute     := Execute,
			Timeout     := Timeout
		);
		State := E_ReadState.ReadBankC;
    (* ══════════════════════════════════════════════════════
       BANK C — FC03, regs 40049-40077
       ══════════════════════════════════════════════════════ *)
    E_ReadState.ReadBankC:
        Execute := TRUE;
        Modbus.ReadRegs(
            UnitID      := SlaveAddr,
            Quantity    := COUNT_C,
            MBAddr      := START_C,
            cbLength    := SIZEOF(RawC),
            pMemoryAddr := ADR(RawC),
            Execute     := Execute,
            Timeout     := Timeout
        );
        State := E_ReadState.WaitBankC;
 
    E_ReadState.WaitBankC:
        Modbus.ReadRegs(
            UnitID      := SlaveAddr,
            Quantity    := COUNT_C,
            MBAddr      := START_C,
            cbLength    := SIZEOF(RawC),
            pMemoryAddr := ADR(RawC),
            Execute     := Execute,
            Timeout     := Timeout
        );
        IF NOT Modbus.Busy THEN
            Execute := FALSE;
            IF Modbus.Error THEN
                ErrorId := Modbus.ErrorId;
                Error   := TRUE;
                State   := E_ReadState.ErrorDelay;
            ELSE
                State := E_ReadState.ParseAll;
            END_IF
        END_IF
 
    (* ══════════════════════════════════════════════════════
       PARSE
       ══════════════════════════════════════════════════════ *)
    E_ReadState.ParseAll:
 
        (* Bank A — 16-bit signed, scale ÷10 volts/angles, ÷100 freq *)
        DeviceID   := WORD_TO_INT(RawA[0]);
        VA_16      := INT_TO_REAL(WORD_TO_INT(RawA[1]))  / 10.0;
        VB_16      := INT_TO_REAL(WORD_TO_INT(RawA[2]))  / 10.0;
        VC_16      := INT_TO_REAL(WORD_TO_INT(RawA[3]))  / 10.0;
        VAvg_16    := INT_TO_REAL(WORD_TO_INT(RawA[4]))  / 10.0;
        VAB_16     := INT_TO_REAL(WORD_TO_INT(RawA[5]))  / 10.0;
        VBC_16     := INT_TO_REAL(WORD_TO_INT(RawA[6]))  / 10.0;
        VCA_16     := INT_TO_REAL(WORD_TO_INT(RawA[7]))  / 10.0;
        VLLAvg_16  := INT_TO_REAL(WORD_TO_INT(RawA[8]))  / 10.0;
        AngAB_16   := INT_TO_REAL(WORD_TO_INT(RawA[9]))  / 10.0;
        AngBC_16   := INT_TO_REAL(WORD_TO_INT(RawA[10])) / 10.0;
        AngAC_16   := INT_TO_REAL(WORD_TO_INT(RawA[11])) / 10.0;
        Freq_16    := INT_TO_REAL(WORD_TO_INT(RawA[12])) / 100.0;
        Overflow   := RawA[13];
        (* Overflow bits: 0=VA, 1=VB, 2=VC, 3=VAvg, 4=VAB, 5=VBC, 6=VCA,
                          7=VLLAvg, 8=AngAB, 9=AngBC, 10=AngAC, 11=Freq *)
 
        (* Bank B — 32-bit floats, big-endian word order *)
        VoltageA     := WordsToReal(RawB[0],  RawB[1]);
        fVoltageB     := WordsToReal(RawB[2],  RawB[3]);
        VoltageC     := WordsToReal(RawB[4],  RawB[5]);
        VoltageAvg   := WordsToReal(RawB[6],  RawB[7]);
        VoltageAB    := WordsToReal(RawB[8],  RawB[9]);
        VoltageBC    := WordsToReal(RawB[10], RawB[11]);
        VoltageCA    := WordsToReal(RawB[12], RawB[13]);
        AngleAB      := WordsToReal(RawB[14], RawB[15]);
        AngleBC      := WordsToReal(RawB[16], RawB[17]);
        AngleAC      := WordsToReal(RawB[18], RawB[19]);
        VoltageLLAvg := WordsToReal(RawB[20], RawB[21]);
        Frequency    := WordsToReal(RawB[22], RawB[23]);
 
        (* Bank C — config / info *)
        PT_Pri_All   := RawC[0];
        PT_Sec_All   := RawC[1];
        PT_Pri_A     := RawC[2];
        PT_Sec_A     := RawC[3];
        PT_Pri_B     := RawC[4];
        PT_Sec_B     := RawC[5];
        PT_Pri_C     := RawC[6];
        PT_Sec_C     := RawC[7];
        Debug16      := WORD_TO_INT(RawC[8]);
        Debug32     := SHL(WORD_TO_DWORD(RawC[9]),  16) OR WORD_TO_DWORD(RawC[10]);
        DebugFloat   := WordsToReal(RawC[11], RawC[12]);
        Uptime      := SHL(WORD_TO_DWORD(RawC[13]), 16) OR WORD_TO_DWORD(RawC[14]);
        LittleEndian := RawC[15] <> 0;
        VoltLEDThr   := WORD_TO_INT(RawC[16]);
        SerialNum   := SHL(WORD_TO_DWORD(RawC[17]), 16) OR WORD_TO_DWORD(RawC[18]);
        HWVersion    := RawC[19];
        FWVersion    := RawC[20];
        BLVersion    := RawC[21];
        ModelNumber  := RawC[22];
        InputConfig  := RawC[23];
        (* awRawC[24..25] = Passcode — skipped *)
        LockState    := RawC[26];
        AutoFreqCh   := RawC[27] <> 0;
        FreqChannel  := RawC[28];
 
        NewData := TRUE;
        Busy    := FALSE;
        State   := E_ReadState.Idle;
 
    (* ══════════════════════════════════════════════════════
       ERROR DELAY — wait before retrying
       ══════════════════════════════════════════════════════ *)
    E_ReadState.ErrorDelay:
        Retry(IN := TRUE, PT := RETRY_TIME);
        IF Retry.Q THEN
            Retry(IN := FALSE);
            State := E_ReadState.Idle;
        END_IF
 
END_CASE
 ]]></ST>
    </Implementation>
    <Method Name="WordsToReal" Id="{b84595d3-9f58-46c1-ac2e-e1607073fc55}">
      <Declaration><![CDATA[METHOD PRIVATE WordsToReal : REAL
VAR_INPUT
    High : WORD;
    Low  : WORD;
END_VAR
VAR
    DataUnion : UNION_DWORD_REAL;
END_VAR
 

]]></Declaration>
      <Implementation>
        <ST><![CDATA[DataUnion.Value_Word   	:= SHL(WORD_TO_DWORD(High), 16) OR WORD_TO_DWORD(Low);
WordsToReal 			:= DataUnion.Value_Real;
 ]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>