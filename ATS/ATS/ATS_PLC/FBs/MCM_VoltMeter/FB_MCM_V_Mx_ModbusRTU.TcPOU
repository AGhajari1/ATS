<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_MCM_V_Mx_ModbusRTU" Id="{1ca84450-dc7b-43bd-b6b9-283fa8345226}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MCM_V_Mx_ModbusRTU
VAR
	INIT			: BIT;
    ModbusFB        : ModbusRtuMasterV2_KL6x22B; 
	Definition		: ST_MCM_Definition;
 	Config			: ST_MCM_Config;
    RawData        	: ARRAY[0..76] OF WORD; 
 	DataOut		   	: ST_MCM_Data;
	CommInitRequest	: BYTE; //not used  TESTING ONLY
	CommCtrl 		: POINTER TO BYTE; //not used  TESTING ONLY
	
    State          	: E_ReadState := E_ReadState.Idle;
    Execute        	: BOOL;
    RetryTimer    	: TON;
	NextReadTimer	: TON;
	ScanDelay		: INT :=0;
	
	Busy           	: BOOL;
    Error          	: BOOL;
    ErrorCode      	: MODBUS_ERRORS;
	
    NewData        	: BOOL;
  
END_VAR
VAR CONSTANT
    REG_START       : UINT := 0;
    REG_COUNT       : UINT := 77;
	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[ModBusSequencer();
VoltageCheck();]]></ST>
    </Implementation>
    <Folder Name="Helper" Id="{69e57e93-eff8-46b3-bf6f-b9d144193202}" />
    <Method Name="ModBusSequencer" Id="{aa86de4e-15b4-4d52-9414-eef997b69729}">
      <Declaration><![CDATA[METHOD PRIVATE ModBusSequencer
]]></Declaration>
      <Implementation>
        <ST><![CDATA[NewData := FALSE;
CommCtrl  := ADR(ModbusFB.OutData.Ctrl); // DO NOT USE OR MANIPULATE TESTING ONLY
CommInitRequest := CommCtrl^; // DO NOT USE OR MANIPULATE TESTING ONLY
IF NOT Config.Enable THEN
    State   := E_ReadState.Idle;
END_IF

CASE State OF
    E_ReadState.Idle:
		INIT:= FALSE;
		//CommCtrl^ := CommCtrl^ AND NOT 16#04; // Clear bit 2 — Init request OFF   TESTING ONLY
        Execute := FALSE;
		NextReadTimer.IN:= TRUE;
		IF Config.Enable AND NextReadTimer.Q THEN
			State   := E_ReadState.ReadData;
			NextReadTimer.IN:= FALSE;
		END_IF
		
    E_ReadState.ReadData:
		Execute := TRUE;
		ScanDelay:=ScanDelay+1;
		IF ScanDelay >=2 THEN
			Execute := FALSE;
		END_IF
		IF ScanDelay>=5 THEN
			ScanDelay := 0;
			State     := E_ReadState.WaitForData;
		END_IF
		
		
    E_ReadState.WaitForData:
        IF NOT Busy THEN
			Execute   := FALSE;
            IF Error THEN
                State     := E_ReadState.ErrorDelay;
            ELSE
                State     := E_ReadState.ParseAll;
            END_IF
        END_IF

    E_ReadState.ParseAll:
        ParseData();
        NewData := TRUE;
		State     := E_ReadState.Idle;

    E_ReadState.ErrorDelay:
		INIT:= TRUE;
		//CommCtrl^ := CommCtrl^ OR 16#04; //Set bit 2 — Init request ON  TESTING ONLY
	 	Execute := FALSE;
        RetryTimer.IN := TRUE;
        IF RetryTimer.Q THEN
            RetryTimer.IN := FALSE;
            State := E_ReadState.Idle;
        END_IF
END_CASE

RetryTimer(PT:=Config.RetryTime);
NextReadTimer(PT:=Config.SampleTime);

ModbusFB.ReadRegs(
    UnitID      := Config.SlaveAddr,
    Quantity    := REG_COUNT,
    MBAddr      := REG_START,
    cbLength    := SIZEOF(RawData),
    pMemoryAddr := ADR(RawData[0]),
    Execute     := Execute,
    Timeout     := Config.Timeout,
	Busy		=>busy,
	Error		=>Error,
	Errorid		=>ErrorCode
);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="P_Config" Id="{d3f163c3-9fce-47dc-8111-cfee114bcdd0}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY P_Config : REFERENCE TO ST_MCM_Config]]></Declaration>
      <Get Name="Get" Id="{270f21f6-cdbc-4953-86f7-d95a0ac1e89b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_Config REF= Config;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_DataOut" Id="{ac05f09d-9c25-4927-a6ab-e35d8d1ab68e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY P_DataOut : REFERENCE TO ST_MCM_Data]]></Declaration>
      <Get Name="Get" Id="{db726667-b38d-4df4-bc57-a5ee952316ce}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_DataOut REF=DataOut;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Definition" Id="{9963e80f-4edd-40e8-90cb-d70be22009de}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY P_Definition : REFERENCE TO ST_MCM_Definition]]></Declaration>
      <Get Name="Get" Id="{bd2c45ac-da66-4942-a0a1-16ac5c0ab3cb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_Definition REF= Definition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ParseData" Id="{c46f2e3a-5ebe-4375-846b-87cb1bc0b137}" FolderPath="Helper\">
      <Declaration><![CDATA[METHOD PRIVATE ParseData]]></Declaration>
      <Implementation>
        <ST><![CDATA[Dataout.DataCount:=Dataout.DataCount+1;
IF Dataout.Datacount >= 1000000 THEN
	Dataout.Datacount := 0;
END_IF
(* Bank A — 16-bit signed, scale ÷10 volts/angles, ÷100 freq *)
DataOut.DeviceID   := WORD_TO_INT(RawData[0]);
DataOut.VA_16      := INT_TO_REAL(WORD_TO_INT(RawData[1]))  / 10.0;
DataOut.VB_16      := INT_TO_REAL(WORD_TO_INT(RawData[2]))  / 10.0;
DataOut.VC_16      := INT_TO_REAL(WORD_TO_INT(RawData[3]))  / 10.0;
DataOut.VAvg_16    := INT_TO_REAL(WORD_TO_INT(RawData[4]))  / 10.0;
DataOut.VAB_16     := INT_TO_REAL(WORD_TO_INT(RawData[5]))  / 10.0;
DataOut.VBC_16     := INT_TO_REAL(WORD_TO_INT(RawData[6]))  / 10.0;
DataOut.VCA_16     := INT_TO_REAL(WORD_TO_INT(RawData[7]))  / 10.0;
DataOut.VLLAvg_16  := INT_TO_REAL(WORD_TO_INT(RawData[8]))  / 10.0;
DataOut.AngAB_16   := INT_TO_REAL(WORD_TO_INT(RawData[9]))  / 10.0;
DataOut.AngBC_16   := INT_TO_REAL(WORD_TO_INT(RawData[10])) / 10.0;
DataOut.AngAC_16   := INT_TO_REAL(WORD_TO_INT(RawData[11])) / 10.0;
DataOut.Freq_16    := INT_TO_REAL(WORD_TO_INT(RawData[12])) / 100.0;
DataOut.Overflow   := RawData[13];
(* Overflow bits: 0=VA, 1=VB, 2=VC, 3=VAvg, 4=VAB, 5=VBC, 6=VCA,
				  7=VLLAvg, 8=AngAB, 9=AngBC, 10=AngAC, 11=Freq *)

(* Bank B — 32-bit floats, big-endian word order *)
DataOut.VoltageA     := WordsToReal(RawData[16],  RawData[17]);
DataOut.VoltageB     := WordsToReal(RawData[18],  RawData[19]);
DataOut.VoltageC     := WordsToReal(RawData[20],  RawData[21]);
DataOut.VoltageAvg   := WordsToReal(RawData[22],  RawData[23]);
DataOut.VoltageAB    := WordsToReal(RawData[24],  RawData[25]);
DataOut.VoltageBC    := WordsToReal(RawData[26], RawData[27]);
DataOut.VoltageCA    := WordsToReal(RawData[28], RawData[29]);
DataOut.AngleAB      := WordsToReal(RawData[30], RawData[31]);
DataOut.AngleBC      := WordsToReal(RawData[32], RawData[33]);
DataOut.AngleAC      := WordsToReal(RawData[34], RawData[35]);
DataOut.VoltageLLAvg := WordsToReal(RawData[36], RawData[37]);
DataOut.Frequency    := WordsToReal(RawData[38], RawData[39]);

(* Bank C — config / info *)
DataOut.PT_Pri_All   := RawData[48];
DataOut.PT_Sec_All   := RawData[49];
DataOut.PT_Pri_A     := RawData[50];
DataOut.PT_Sec_A     := RawData[51];
DataOut.PT_Pri_B     := RawData[52];
DataOut.PT_Sec_B     := RawData[53];
DataOut.PT_Pri_C     := RawData[54];
DataOut.PT_Sec_C     := RawData[55];
DataOut.Debug16      := WORD_TO_INT(RawData[56]);
DataOut.Debug32      := SHL(WORD_TO_DWORD(RawData[57]),  16) OR WORD_TO_DWORD(RawData[58]);
DataOut.DebugFloat   := WordsToReal(RawData[59], RawData[60]);
DataOut.Uptime       := SHL(WORD_TO_DWORD(RawData[61]), 16) OR WORD_TO_DWORD(RawData[62]);
DataOut.LittleEndian := RawData[63] <> 0;
DataOut.VoltLEDThr   := WORD_TO_INT(RawData[64]);
DataOut.SerialNum    := SHL(WORD_TO_DWORD(RawData[65]), 16) OR WORD_TO_DWORD(RawData[66]);
DataOut.HWVersion    := RawData[67];
DataOut.FWVersion    := RawData[68];
DataOut.BLVersion    := RawData[69];
DataOut.ModelNumber  := RawData[70];
DataOut.InputConfig  := RawData[71];
(* awRawC[72..73] = Passcode — skipped *)
DataOut.LockState    := RawData[74];
DataOut.AutoFreqCh   := RawData[75] <> 0;
DataOut.FreqChannel  := RawData[76];]]></ST>
      </Implementation>
    </Method>
    <Method Name="VoltageCheck" Id="{d12d065a-8f72-408c-9921-036420f737d9}">
      <Declaration><![CDATA[METHOD PRIVATE VoltageCheck
VAR_INST
	AverageVoltage	: REAL;
	VoltageOK       : BOOL;
	FrequencyOK		: BOOL;
	PhaseAngleAB_OK	: BOOL;
	PhaseAngleBC_OK	: BOOL;
	PhaseAngleCA_OK	: BOOL;
	StabilityTimer 	: TON;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//VOLTAGE CHECK
AverageVoltage := (DataOut.VAB_16 + DataOut.VBC_16 + DataOut.VCA_16) / 3.0;

VoltageOK := (AverageVoltage >= Config.NominalVoltage * (1.0 - Config.VoltageTolerance)) AND
             (AverageVoltage <= Config.NominalVoltage * (1.0 + Config.VoltageTolerance));


//FREQUENCY CHECK
FrequencyOK := (DataOut.Frequency >= Config.NominalFrequency - Config.FrequencyTolerance) AND
               (DataOut.Frequency <= Config.NominalFrequency + Config.FrequencyTolerance);

//PHASE ANGLE CHECKS
PhaseAngleAB_OK := ABS(DataOut.AngAB_16 - 0.0)   <= Config.AngleTolerance OR ABS(DataOut.AngAB_16 - 360.0)   <= Config.AngleTolerance;
PhaseAngleBC_OK := ABS(DataOut.AngBC_16 - 120.0)  <= Config.AngleTolerance;
PhaseAngleCA_OK := ABS(DataOut.AngAC_16 - 240.0)  <= Config.AngleTolerance;

//WAIT TO STABLIZE
StabilityTimer (IN  := VoltageOK AND FrequencyOK AND PhaseAngleAB_OK AND PhaseAngleBC_OK AND PhaseAngleCA_OK,
           		PT  := Config.StableTime);

DataOut.VoltageStabilized := StabilityTimer .Q;

//git test]]></ST>
      </Implementation>
    </Method>
    <Method Name="WordsToReal" Id="{b84595d3-9f58-46c1-ac2e-e1607073fc55}" FolderPath="Helper\">
      <Declaration><![CDATA[METHOD PRIVATE WordsToReal : REAL
VAR_INPUT
    High : WORD;
    Low  : WORD;
END_VAR
VAR
    DataUnion : UNION_DWORD_REAL;
END_VAR
 

]]></Declaration>
      <Implementation>
        <ST><![CDATA[DataUnion.Value_Word   	:= SHL(WORD_TO_DWORD(High), 16) OR WORD_TO_DWORD(Low);
WordsToReal 			:= DataUnion.Value_Real;
 ]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>